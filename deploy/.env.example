# Copy to deploy/.env and fill in. Never commit the real file.

# Your public hostname (DNS A record -> this server) or Tailscale name
SASTRA_DOMAIN=sastra.example.com

# REQUIRED secrets — generate with:
#   python -m sastra gen-key            (DATA_KEY: 32-byte AES key, base64)
#   python -c "import secrets;print(secrets.token_urlsafe(48))"   (JWT_SECRET)
# Keep a copy of DATA_KEY somewhere safe and OFF the server: without it,
# encrypted backups and TOTP secrets cannot be recovered.
SASTRA_JWT_SECRET=
SASTRA_DATA_KEY=

# Model providers (all optional — with none, SASTRA runs in honest offline mode)
SASTRA_ANTHROPIC_API_KEY=
SASTRA_ANTHROPIC_MODEL=claude-sonnet-5-5
SASTRA_ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, or your own Ollama/llama.cpp
SASTRA_OPENAI_COMPAT_BASE_URL=
SASTRA_OPENAI_COMPAT_API_KEY=
SASTRA_OPENAI_COMPAT_MODEL=
SASTRA_OPENAI_COMPAT_IS_LOCAL=false
SASTRA_EMBED_MODEL=

# Search (pick one or more; SearXNG self-hosted is free)
SASTRA_SEARXNG_URL=
SASTRA_BRAVE_API_KEY=
SASTRA_TAVILY_API_KEY=

# Hard spending caps in USD (fail closed). 0 = no paid usage at all.
SASTRA_DAILY_BUDGET_USD=0.50
SASTRA_MONTHLY_BUDGET_USD=10

# Privacy
SASTRA_CONVERSATION_RETENTION_DAYS=90
